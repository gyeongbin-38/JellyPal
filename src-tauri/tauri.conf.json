{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jellypal",
  "version": "0.2.9",
  "identifier": "com.jellypal.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Jellypal",
        "width": 480,
        "height": 140,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Entertainment",
    "shortDescription": "Desktop slime companion",
    "longDescription": "Jellypal — cute pixel-art slimes that live on your desktop, play on your windows, and keep you company while you work.",
    "resources": {
      "WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
